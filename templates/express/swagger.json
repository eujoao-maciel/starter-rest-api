{
  "openapi": "3.0.3",
  "info": {
    "title": "Starter REST API",
    "version": "1.0.0",
    "description": "Documentação da API REST inicial."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Verifica a saúde da API",
        "description": "Retorna o status atual do servidor.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Servidor está disponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "message": "server on"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "server on"
          }
        }
      }
    }
  }
}
